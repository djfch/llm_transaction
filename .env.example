# Gate.io APIv4 密钥（真实 key 由用户本人填写，禁止提交到 git）
GATE_API_KEY=
GATE_API_SECRET=

# LLM Provider 密钥
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── 研报 agent（可选，第一期）──────────────────────────────────────────
# 金十 MCP Bearer token（来源：全局 Kimi Code mcp.json 的 jin10 配置）
JIN10_MCP_TOKEN=
# BlockBeats MCP API key（来源：全局 Kimi Code mcp.json 的 blockbeats 配置）
BLOCKBEATS_API_KEY=
# FRED 宏观数据 API key（免费注册：https://fred.stlouisfed.org/docs/api/api_key.html）
FRED_API_KEY=

# Telegram 通知（可选）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
